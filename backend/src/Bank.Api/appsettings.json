{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "BankDb": "Server=localhost;Database=BankDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Banking": {
    "MaxAccountsPerCurrency": 5,
    "TransferLimits": {
      "TRY": { "PerTransfer": 250000, "Daily": 750000 },
      "USD": { "PerTransfer": 25000, "Daily": 75000 },
      "EUR": { "PerTransfer": 25000, "Daily": 75000 }
    }
  },
  "MarketData": {
    "CacheMinutes": 10,
    "Tcmb": { "BaseUrl": "https://www.tcmb.gov.tr/" }
  },
  "Jwt": {
    "Issuer": "BankApi",
    "Audience": "BankClient",
    "ExpiresMinutes": 10
  },
  "Session": {
    "RefreshTokenHours": 8
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Messaging": {
    "Enabled": false,
    "PollInterval": "00:00:02",
    "BatchSize": 50,
    "RabbitMq": {
      "Host": "localhost",
      "Port": 5672,
      "VirtualHost": "/",
      "Exchange": "bank.events"
    }
  },
  "AllowedHosts": "*"
}
